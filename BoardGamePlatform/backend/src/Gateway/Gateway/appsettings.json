{
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "lobby": {
        "ClusterId": "lobby-cluster",
        "Match": {
          "Path": "/api/lobby/{**catch-all}"
        }
      },
      "game": {
        "ClusterId": "game-cluster",
        "Match": {
          "Path": "/api/game/{**catch-all}"
        }
      },
      "lobby-hub": {
        "ClusterId": "lobby-cluster",
        "Match": {
          "Path": "/hubs/lobby/{**catch-all}"
        }
      },
      "game-hub": {
        "ClusterId": "game-cluster",
        "Match": {
          "Path": "/hubs/game/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5201/"
          }
        }
      },
      "lobby-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5202/"
          }
        }
      },
      "game-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5203/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}